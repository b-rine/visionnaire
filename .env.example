# Copy this file to .env and fill in real values. .env is gitignored.

# Storage backend: "local" (default) stores photos on disk; "r2" uses Cloudflare R2.
STORAGE_BACKEND=local

# Local storage directory — only used when STORAGE_BACKEND=local.
# Defaults to ./photos when running the backend directly (outside Docker).
# Docker Compose overrides this to /data/photos (a named volume).
LOCAL_PHOTOS_DIR=

# Cloudflare R2 — required only when STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Shared API key required on write endpoints (upload, delete, caption edit).
# Generate one with: openssl rand -hex 24
API_KEY=

# Comma-separated list of allowed CORS origins. Defaults to "*" if unset,
# which is fine for local dev — set this to the real public domain in
# production (e.g. https://photos.example.com).
ALLOWED_ORIGINS=

# Triton connection. Defaults below match the local docker-compose setup
# (Triton runs as the "triton" service on the same Docker network) — only
# needed in .env if Triton is reached remotely (e.g. over a Cloudflare
# Tunnel from a deployed backend back to a home GPU machine).
TRITON_HOST=triton
TRITON_PORT=8000
TRITON_SSL=false

# Cloudflare Access service token, only needed if Triton is reached through
# a Cloudflare Tunnel hostname protected by an Access policy. Leave blank
# for local dev — both must be set together or neither is sent.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Cloudflare Tunnel connector tokens — generated in the Zero Trust dashboard
# (Networks → Tunnels → Create tunnel → Docker → copy the token value).

# Oracle instance: token for the public-facing tunnel that routes
# photos.yourdomain.com → the frontend container.
CLOUDFLARE_TUNNEL_TOKEN=

# Home machine: token for the private Triton bridge tunnel that routes
# triton-internal.yourdomain.com → the Triton container.
# Only needed in the home machine's .env (docker-compose.yml reads it).
TRITON_TUNNEL_TOKEN=
