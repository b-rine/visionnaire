name: "coca"
backend: "python"
max_batch_size: 1

input [
  {
    name: "input_data"
    data_type: TYPE_STRING
    dims: [1]
  },
  {
    name: "input_mode"
    data_type: TYPE_STRING
    dims: [1]
  }
]

output [
  {
    name: "embedding"
    data_type: TYPE_FP32
    dims: [768]
  },
  {
    name: "caption"
    data_type: TYPE_STRING
    dims: [1]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]
