{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/api/photos/upload",
      "methods": ["POST"],
      "dest": "/api/preview-read-only"
    },
    {
      "src": "/api/photos/[^/]+",
      "methods": ["PATCH", "DELETE"],
      "dest": "/api/preview-read-only"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://visionnaire.nguyenbrian.dev/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
